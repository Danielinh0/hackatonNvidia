# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase credentials
serviceAccount*.json

# base de datos SQLite local (contiene las fotos subidas)
frontend-pwa/data/

# datos generados y fotos reales de prueba (no se suben al repo público)
training/data/*/*
!training/data/*/.gitkeep
training/.venv/
training/.cache/
__pycache__/
